# Copy to .env for `docker compose up`. Defaults below work out of the box.

# --- Postgres ---
POSTGRES_USER=rps
POSTGRES_PASSWORD=rps_dev_password
POSTGRES_DB=rps

# --- Server ---
# Connection string the server/Prisma use. Host "postgres" is the compose service.
DATABASE_URL=postgresql://rps:rps_dev_password@postgres:5432/rps?schema=public
SERVER_PORT=4000
# Secret used to sign the session cookie. Change in any real deployment.
SESSION_SECRET=change-me-in-production-please
# Origin the browser loads the client from (for CORS + cookies).
CLIENT_ORIGIN=http://localhost:8080
NODE_ENV=production
# Set to true ONLY when serving over HTTPS (otherwise the cookie won't be sent).
COOKIE_SECURE=false

# --- Client (baked at build time) ---
# Where the browser reaches the API/Socket.IO server.
VITE_SERVER_URL=http://localhost:4000
